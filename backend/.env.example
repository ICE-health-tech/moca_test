SPRING_PROFILES_ACTIVE=dev

DB_HOST=192.168.22.111
DB_PORT=5432
DB_NAME=moca-test-db
DB_USER=duylong
DB_PASSWORD=duylongadminpass
SERVER_PORT=8080

# JWT signing key — HS384 needs ≥48 characters. Use same value across deploys.
JWT_SECRET=change-me-to-a-random-string-at-least-48-chars-long

# PostgreSQL admin UI (pgAdmin): http://192.168.22.111/browser/
# Database name on server "DuyLong": moca-test-db

# MinIO — homelab S3 (Section 1 canvas PNGs)
MINIO_ENABLED=false
MINIO_ENDPOINT=http://192.168.22.19:9000
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET=moca-drawings
MINIO_AUTO_CREATE_BUCKET=false

# Redis — remote cache (https://redis.duylong.art/ is web UI; app uses redis:// host:6379)
REDIS_ENABLED=true
REDIS_HOST=redis.duylong.art
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_SSL=true

# Hikari (prod profile) — optional overrides for application-prod.yml
# HIKARI_MAX_POOL_SIZE=20
# HIKARI_MIN_IDLE=5
# HIKARI_CONNECTION_TIMEOUT=30000
# HIKARI_IDLE_TIMEOUT=600000
# HIKARI_MAX_LIFETIME=1800000

# ── AI / Whisper (section 5 sentence repetition assist) ─────────────────────
# Copy these into backend/.env, then: set -a && source .env && set +a
# Yellow = AI transcript assist; green = doctor score (source of truth).
#
# Mode A — OpenAI Whisper API
#   WHISPER_ENABLED=true
#   WHISPER_PROVIDER=openai
#   WHISPER_BASE_URL=https://api.openai.com/v1
#   WHISPER_API_KEY=sk-...
#   WHISPER_MODEL=whisper-1
#
# Mode B — local Whisper ASR (no API key)
#   docker compose --profile local-whisper up -d
#   WHISPER_ENABLED=true
#   WHISPER_PROVIDER=local
#   WHISPER_BASE_URL=http://localhost:9002
#   WHISPER_API_KEY=
#   WHISPER_MODEL=base
WHISPER_ENABLED=false
WHISPER_PROVIDER=openai
WHISPER_BASE_URL=https://api.openai.com/v1
WHISPER_API_KEY=
WHISPER_MODEL=whisper-1
WHISPER_LANGUAGE=vi
WHISPER_TIMEOUT_MS=60000
